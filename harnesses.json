{
  "skillsRoot": "~/.agents/skills",
  "harnesses": {
    "pi": {
      "name": "Pi Coding Agent",
      "bin": "pi",
      "skillsMode": "native",
      "configDir": "configs/pi",
      "targetDir": "~/.pi/agent"
    },
    "opencode": {
      "name": "OpenCode",
      "bin": "opencode",
      "skillsMode": "config",
      "configFile": "~/.config/opencode/opencode.json"
    },
    "agy": {
      "name": "Antigravity (Gemini)",
      "skillsMode": "symlink",
      "skillsPath": "~/.gemini/config/skills"
    },
    "t3": {
      "name": "T3 Code",
      "bin": ["t3code", "t3"],
      "skillsMode": "delegated",
      "targetDir": "~/.t3/userdata"
    }
  }
}
