{
  "skillsRoot": "~/.agents/skills",
  "harnesses": {
    "pi": {
      "name": "Pi Coding Agent",
      "bin": "pi",
      "npmPackage": "@earendil-works/pi-coding-agent",
      "t3Provider": {
        "id": "pi",
        "driver": "pi",
        "displayName": "Pi"
      },
      "skillsMode": "native",
      "configDir": "configs/pi",
      "targetDir": "~/.pi/agent"
    },
    "opencode": {
      "name": "OpenCode",
      "bin": "opencode",
      "npmPackage": "opencode-ai",
      "aurPackage": "opencode",
      "t3Provider": {
        "id": "opencode",
        "driver": "opencode",
        "displayName": "OpenCode"
      },
      "skillsMode": "config",
      "configFile": "~/.config/opencode/opencode.json"
    },
    "agy": {
      "name": "Antigravity (Gemini)",
      "t3Provider": {
        "id": "antigravity",
        "driver": "antigravity"
      },
      "skillsMode": "symlink",
      "skillsPath": "~/.gemini/config/skills"
    }
  }
}
