{
  "skillsRoot": "~/skills",
  "harnesses": {
    "universal": {
      "name": "Universal Agent Skills",
      "skillsPath": "~/.agents/skills"
    },
    "agy": {
      "name": "Antigravity (Gemini)",
      "skillsPath": "~/.gemini/config/skills"
    },
    "opencode": {
      "name": "OpenCode",
      "bin": "opencode",
      "skillsPath": "~/.config/opencode/skills"
    },
    "pi": {
      "name": "Pi Coding Agent",
      "bin": "pi",
      "skillsPath": "~/.pi/agent/skills",
      "configDir": "configs/pi",
      "targetDir": "~/.pi/agent"
    },
    "t3": {
      "name": "T3 Code",
      "bin": ["t3code", "t3"],
      "targetDir": "~/.t3/userdata"
    }
  }
}
